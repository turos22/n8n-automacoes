      "parameters": {
        "jsCode": "let mes_s = $input.first().json.data_hora_transacao.slice(3,5);\nlet mes = parseInt(mes_s);\nlet nome_arq = '';\n\nswitch (mes) {\n  case 1:  nome_arq = '2026_Janeiro'; break;\n  case 2:  nome_arq = '2026_Fevereiro'; break;\n  case 3:  nome_arq = '2026_Marco'; break;\n  case 4:  nome_arq = '2026_Abril'; break;\n  case 5:  nome_arq = '2026_Maio'; break;\n  case 6:  nome_arq = '2026_Junho'; break;\n  case 7:  nome_arq = '2026_Julho'; break;\n  case 8:  nome_arq = '2026_Agosto'; break;\n  case 9:  nome_arq = '2026_Setembro'; break;\n  case 10: nome_arq = '2026_Outubro'; break;\n  case 11: nome_arq = '2026_Novembro'; break;\n  case 12: nome_arq = '2026_Dezembro'; break;\n  default:\n    nome_arq = 'Mes_Invalido';\n    break;\n}\n\nreturn { nome_arquivo: nome_arq };"
      },
