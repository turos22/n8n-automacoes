      "parameters": {
        "jsCode": "const input = $input.first().json.categoria; \nlet desc = '';\n\nswitch (input) {\n  case 'Alimentação':  desc = '🍔 Alimentação'; break;\n  case 'Transporte':   desc = '🚌 Transporte'; break;\n  case 'Moradia':      desc = '🏠 Moradia'; break;\n  case 'Lazer':        desc = '🎉 Lazer'; break;\n  case 'Saúde':        desc = '🩺 Saúde'; break;\n  case 'Educação':     desc = '📚 Educação'; break;\n  case 'Viagem':       desc = '✈️ Viagem'; break;\n  case 'Trabalho':     desc = '🖥️ Trabalho'; break;\n  default: desc = 'Outros';\n}\n\nreturn { categoria_final: desc };"
      },
